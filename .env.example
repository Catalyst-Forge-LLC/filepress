# Per-site identity, inlined at build time. Copy to `.env` and edit per site.
# Every Downpress site is served from a custom domain, so PUBLIC_SITE_URL is the
# canonical origin with no base path. All are optional; defaults are the engine's
# own demo identity.

PUBLIC_SITE_TITLE="Downpress"
PUBLIC_SITE_DESCRIPTION="A git-native Markdown blog. Every post is a file; every push deploys."
PUBLIC_SITE_URL="https://downpress.example.com"
PUBLIC_SITE_AUTHOR="Downpress"
