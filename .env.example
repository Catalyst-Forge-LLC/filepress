# Per-site identity, inlined at build time. Copy to `.env` and edit per site.
# Every Downpress site is served from a custom domain, so PUBLIC_SITE_URL is the
# canonical origin with no base path. All are optional; defaults are the engine's
# own demo identity.

# Where the Markdown posts live (absolute, or relative to the project root).
# Defaults to the in-repo `posts/` folder.
# DOWNPRESS_CONTENT_DIR="../my-site/posts"

PUBLIC_SITE_TITLE="Downpress"
PUBLIC_SITE_DESCRIPTION="A git-native Markdown blog. Every post is a file; every push deploys."
# Longer line shown in the index hero; falls back to the description above.
PUBLIC_SITE_TAGLINE=""
PUBLIC_SITE_URL="https://downpress.example.com"
PUBLIC_SITE_AUTHOR="Downpress"

# Index pagination (posts per page after the featured one). Defaults to 10.
PUBLIC_SITE_POSTS_PER_PAGE="10"

# Optional newsletter CTA. Leave the URL blank to hide it everywhere.
PUBLIC_SITE_NEWSLETTER_URL=""
PUBLIC_SITE_NEWSLETTER_BLURB="Get new essays in your inbox. No spam, unsubscribe anytime."
PUBLIC_SITE_NEWSLETTER_CTA="Subscribe"
