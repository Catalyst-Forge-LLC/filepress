{
	"name": "downpress-workspace",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Downpress monorepo: the @downpress/core engine plus independently buildable sites.",
	"scripts": {
		"test": "pnpm --filter @downpress/core test",
		"check": "pnpm -r --if-present check",
		"build": "pnpm -r --if-present build",
		"build:nth": "pnpm --filter example-site build",
		"dev:nth": "pnpm --filter example-site dev",
		"create-site": "node scripts/create-site.mjs"
	}
}
